"""FastAPI service. Receives Pine alerts, persists state, emits Telegram cards."""
from __future__ import annotations

import logging
from contextlib import asynccontextmanager
from datetime import date, datetime

from fastapi import BackgroundTasks, FastAPI, HTTPException, Request, status

from src.logger import trade_log
from src.notify import telegram
from src.risk import tracker
from src.schemas import Action, Signal, Strategy
from src.session import clock
from src.settings import settings
from src.state import store

logging.basicConfig(
    level=getattr(logging, settings().log_level.upper(), logging.INFO),
    format="%(asctime)s %(levelname)s %(name)s %(message)s",
)
log = logging.getLogger("nq-dual-bot")


@asynccontextmanager
async def lifespan(app: FastAPI):
    await store.init_db()
    log.info("service_started", extra={"dry_run": settings().dry_run_notify_only})
    yield
    log.info("service_stopped")


app = FastAPI(title="NQ Dual-Strategy Bot", lifespan=lifespan)


@app.get("/health")
async def health() -> dict:
    phase = clock.phase_at()
    open_pos = await store.current_open_position()
    kill = await store.kill_switch_active()
    today = await tracker.daily_pnl()
    return {
        "status": "ok",
        "time_ny": clock.now_ny().isoformat(),
        "phase": phase.phase.value,
        "active_strategy": phase.active_strategy,
        "allows_new_entries": phase.allows_new_entries,
        "open_position": open_pos,
        "today": today,
        "kill_switch": kill,
        "dry_run": settings().dry_run_notify_only,
    }


@app.post("/webhook")
async def webhook(request: Request, background: BackgroundTasks) -> dict:
    """Primary entry point for TradingView alerts."""
    try:
        payload = await request.json()
    except Exception as exc:
        log.warning("bad_json", extra={"err": str(exc)})
        raise HTTPException(status.HTTP_400_BAD_REQUEST, "invalid json")

    # Shared-secret check
    if payload.get("secret") != settings().webhook_secret:
        log.warning("bad_secret", extra={"ip": request.client.host if request.client else "?"})
        raise HTTPException(status.HTTP_401_UNAUTHORIZED, "bad secret")

    try:
        sig = Signal(**payload)
    except Exception as exc:
        log.warning("signal_parse_failed", extra={"err": str(exc), "raw": payload})
        raise HTTPException(status.HTTP_422_UNPROCESSABLE_ENTITY, f"bad signal: {exc}")

    log.info(
        "signal_received",
        extra={"strategy": sig.strategy.value, "action": sig.action.value, "price": sig.price},
    )

    background.add_task(_handle_signal, sig)
    return {"ok": True, "received": sig.action.value}


async def _handle_signal(sig: Signal) -> None:
    """Process a signal: update state, compute P&L on exits, emit Telegram card, log."""
    try:
        if sig.is_entry:
            await tracker.record_entry(sig)
            trade_log.append_row(
                strategy=sig.strategy.value,
                action=sig.action.value,
                direction=sig.direction,
                ticker=sig.ticker,
                price=sig.price,
                contracts=sig.contracts,
                stop_pts=sig.stop_pts,
                note=_entry_note(sig),
            )
            await telegram.send_entry_card(sig)
        elif sig.is_exit:
            pts, usd = await tracker.record_exit(sig)
            trade_log.append_row(
                strategy=sig.strategy.value,
                action=sig.action.value,
                direction=sig.direction,
                ticker=sig.ticker,
                price=sig.price,
                contracts=sig.contracts,
                stop_pts=sig.stop_pts,
                pnl_points=pts,
                pnl_usd=usd,
                note="",
            )
            await telegram.send_exit_card(sig, pnl_usd=usd, pnl_pts=pts)
        else:
            log.warning("unhandled_action", extra={"action": sig.action.value})
    except Exception as exc:
        log.exception("signal_handler_error")
        await telegram.send_alert(f"Signal handler error: {exc}")


def _entry_note(sig: Signal) -> str:
    phase = clock.phase_at()
    note = f"phase={phase.phase.value}"
    if sig.strategy == Strategy.RTH_PDHL and not clock.is_in_rth_window():
        note += ";WARN:entry_outside_rth_window"
    return note


@app.get("/status")
async def status_endpoint() -> dict:
    phase = clock.phase_at()
    today = await tracker.daily_pnl()
    open_pos = await store.current_open_position()
    return {
        "phase": phase.phase.value,
        "allows_new_entries": phase.allows_new_entries,
        "today": today,
        "open_position": open_pos,
        "kill_switch": await store.kill_switch_active(),
    }


@app.post("/admin/kill")
async def admin_kill(reason: str = "manual") -> dict:
    await store.set_kill_switch(True, reason)
    await telegram.send_alert(f"KILL SWITCH ENABLED: {reason}")
    return {"ok": True}


@app.post("/admin/resume")
async def admin_resume() -> dict:
    await store.set_kill_switch(False, None)
    await telegram.send_alert("Kill switch released.")
    return {"ok": True}


@app.post("/admin/commit-logs")
async def admin_commit_logs() -> dict:
    ok = await trade_log.commit_to_github()
    return {"ok": ok}


@app.post("/admin/daily-summary")
async def admin_daily_summary() -> dict:
    d = date.today()
    stats = await tracker.daily_pnl(d)
    await telegram.send_daily_summary(
        stats["date"],
        stats["pnl_usd"],
        stats["entries"],
        stats["wins"],
        stats["losses"],
    )
    return {"ok": True, **stats}
